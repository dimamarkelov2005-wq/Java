public class Task16 {

    static int maxX(){

        int[] array = new int[10];

        for(int i=0;i<array.length;i++)
            array[i]=(int)(Math.random()*50);

        int max=array[0];

        for(int i=1;i<array.length;i++)
            if(array[i]>max)
                max=array[i];

        return max;
    }

    public static void main(String[] args) {

        System.out.println("Максимальный элемент = "+maxX());
    }
}
