public class Task11 {
    public static void main(String[] args) {

        int[] A = new int[25];

        for(int i=0;i<A.length;i++){
            A[i]=(int)(Math.random()*100);
            System.out.print(A[i]+" ");
        }

        int max=0,min=0;

        for(int i=1;i<A.length;i++){
            if(A[i]>A[max]) max=i;
            if(A[i]<A[min]) min=i;
        }

        int temp=A[max];
        A[max]=A[min];
        A[min]=temp;

        System.out.println("\nПосле обмена:");

        for(int i:A)
            System.out.print(i+" ");
    }
}
